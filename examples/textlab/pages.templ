package main

import "github.com/coolapso/c4stack/credits"

templ homePage() {
	<section class="hero stack">
		<h1>Count words for a cent or two</h1>
		<p class="lead">Textlab is an example C4Stack app: a small paid text API with API keys, prepaid credit and jobs that hold credit while they run.</p>
		<p class="cluster">
			<a class="btn primary" href="/account">Open the console</a>
		</p>
	</section>
}

templ overviewPage(s credits.Summary, activeKeys int, jobs []job) {
	<div class="page-header">
		<h1>Overview</h1>
	</div>
	<section class="panel">
		<div class="grid">
			<div class="stat">
				<span class="stat-label">Available credit</span>
				<span class="stat-value">{ credits.FormatEuros(s.AvailableCents) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Held by running jobs</span>
				<span class="stat-value">{ credits.FormatEuros(s.HeldCents) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Active API keys</span>
				<span class="stat-value">{ activeKeys }</span>
			</div>
		</div>
	</section>
	<section class="panel">
		<div class="panel-header">
			<div>
				<h2>Recent jobs</h2>
			</div>
			<a class="btn small" href="/account/jobs">All jobs</a>
		</div>
		@jobTable(jobs)
	</section>
}

templ jobsPage(jobs []job) {
	<div class="page-header">
		<h1>Jobs</h1>
		<p class="lead">A job holds its estimated cost while it runs, and is charged when it completes.</p>
	</div>
	<section class="panel">
		@jobTable(jobs)
	</section>
}

templ jobTable(jobs []job) {
	if len(jobs) == 0 {
		<p class="empty">No jobs yet. Start one with POST /api/v1/jobs.</p>
	} else {
		<div class="table-wrap">
			<table class="data-table">
				<thead>
					<tr>
						<th scope="col">Started</th>
						<th scope="col">Status</th>
						<th scope="col">Input</th>
						<th scope="col" class="number">Cost</th>
					</tr>
				</thead>
				<tbody>
					for _, j := range jobs {
						<tr>
							<td>{ j.CreatedAt.UTC().Format("2 Jan 15:04") }</td>
							<td>
								if j.Status == "done" {
									<span class="tag success">Done</span>
								} else {
									<span class="tag">Running</span>
								}
							</td>
							<td>{ preview(j.Input) }</td>
							<td class="number">
								if j.ChargedCents.Valid {
									{ credits.FormatEuros(j.ChargedCents.Int64) }
								} else {
									{ credits.FormatEuros(j.ReservedCents) } held
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func preview(s string) string {
	r := []rune(s)
	if len(r) > 60 {
		return string(r[:60]) + "…"
	}
	return s
}
