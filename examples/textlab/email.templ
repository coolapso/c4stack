package main

import "github.com/coolapso/c4stack/email"

// emailLayout gives Textlab's emails, the sign-in codes and notices and the credit
// expiry warning, the console's look. Mail apps keep the style element in the head
// and load nothing from the web, so everything is here.
templ emailLayout(p email.Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<title>{ p.Subject }</title>
			<style>
				body { margin: 0; padding: 24px 12px; background: #0d1117; color: #e6edf3; font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
				.mail { max-width: 560px; margin: 0 auto; }
				.brand { margin: 0 0 16px; color: #2dd4bf; font: 700 15px/1 ui-monospace, Menlo, Consolas, monospace; }
				.card { padding: 8px 28px; background: #151b23; border: 1px solid #26303b; border-radius: 10px; }
				.code { padding: 12px 16px; background: #0b0f14; border-radius: 6px; font: 600 26px/1.3 ui-monospace, Menlo, Consolas, monospace; letter-spacing: 0.1em; }
				.button { display: inline-block; padding: 10px 18px; background: #2dd4bf; color: #042f2e; border-radius: 6px; font-weight: 600; text-decoration: none; }
				.foot { margin: 16px 0 0; color: #8b98a5; font-size: 13px; }
			</style>
		</head>
		<body>
			<div style="display: none; max-height: 0; overflow: hidden">{ p.Preview }</div>
			<div class="mail">
				<p class="brand">textlab</p>
				<div class="card">
					@p.Body
				</div>
				<p class="foot">Textlab, C4Stack's example app.</p>
			</div>
		</body>
	</html>
}
