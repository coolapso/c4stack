# Settings for local development. Copy to .env and fill in. Never commit .env.
TEXTLAB_PUBLIC_URL=http://localhost:8080
TEXTLAB_DATABASE_URL=postgres://textlab:textlab@localhost:5433/textlab?sslmode=disable
# openssl rand -hex 32
TEXTLAB_SECRET_KEY=
TEXTLAB_HANKO_API_URL=https://your-tenant.hanko.io
# A Creem test-mode key, webhook secret and one-time product with a custom price.
TEXTLAB_CREEM_API_KEY=creem_test_
TEXTLAB_CREEM_WEBHOOK_SECRET=
TEXTLAB_CREEM_PRODUCT_ID=
# Optional: with Scaleway email configured, unused credit expires after a warning.
TEXTLAB_SCALEWAY_SECRET_KEY=
TEXTLAB_SCALEWAY_PROJECT_ID=
TEXTLAB_EMAIL_FROM=
TEXTLAB_LOG_FORMAT=text
TEXTLAB_LOG_LEVEL=debug
