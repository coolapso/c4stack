package credits

import (
	"strconv"

	"github.com/coolapso/c4stack/ui"
)

templ creditsPage(v creditsView) {
	<div class="page-header">
		<h1>Credits</h1>
		<p class="lead">Credit pays for what you use. One credit is one euro cent.</p>
	</div>
	if v.returned {
		@statusFragment(v.base, "pending")
	}
	<section class="panel" aria-labelledby="balance-title">
		<h2 id="balance-title" class="sr-only">Balance</h2>
		<div id="credit-summary" class="grid" hx-get={ v.base + "?summary=1" } hx-trigger="credits-changed from:body" hx-select="#credit-summary" hx-swap="outerHTML">
			<div class="stat">
				<span class="stat-label">Available</span>
				<span class="stat-value">{ FormatEuros(v.summary.AvailableCents) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Balance</span>
				<span class="stat-value">{ FormatEuros(v.summary.BalanceCents) }</span>
			</div>
			if v.summary.HeldCents > 0 {
				<div class="stat">
					<span class="stat-label">Reserved for work in progress</span>
					<span class="stat-value">{ FormatEuros(v.summary.HeldCents) }</span>
				</div>
			}
		</div>
	</section>
	<section class="panel" aria-labelledby="buy-title">
		<div class="panel-header">
			<div>
				<h2 id="buy-title">Buy credit</h2>
				<p>
					Between { FormatEuros(v.policy.MinPurchaseCents) } and { FormatEuros(v.policy.MaxPurchaseCents) }.
					if v.policy.FeeBasisPoints > 0 || v.policy.FeeFixedCents > 0 {
						A payment fee is added at checkout.
					}
				</p>
			</div>
		</div>
		<form class="stack" method="post" action={ templ.SafeURL(v.base + "/checkout") } data-busy-form>
			@ui.CSRFField(v.c)
			<div class="form-row">
				<div class="field">
					<label for="credit-amount">Amount in euros</label>
					<input
						id="credit-amount"
						name="amount"
						type="text"
						inputmode="decimal"
						autocomplete="off"
						value={ v.amount }
						required
						hx-get={ v.base + "/quote" }
						hx-trigger="input changed delay:300ms, load"
						hx-target="#credit-quote"
						if v.err != "" {
							aria-invalid="true"
						}
						aria-describedby="credit-quote"
					/>
				</div>
				<button type="submit" class="btn primary">
					Continue to payment
					@ui.Spinner()
				</button>
			</div>
			<div id="credit-quote" aria-live="polite">
				if v.err != "" {
					<p class="field-error" role="alert">{ v.err }</p>
				}
			</div>
		</form>
	</section>
	<section class="panel" aria-labelledby="history-title">
		<h2 id="history-title">History</h2>
		if len(v.entries) == 0 {
			<p class="empty">No credit activity yet.</p>
		} else {
			<div class="table-wrap">
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">Date</th>
							<th scope="col">Description</th>
							<th scope="col" class="number">Amount</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range v.entries {
							<tr>
								<td>{ e.CreatedAt.UTC().Format("2 Jan 2006 15:04") }</td>
								<td>{ describe(e) }</td>
								<td class="number">{ FormatEuros(e.AmountCents) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if v.older > 0 {
				<p class="pagination">
					<a href={ templ.SafeURL(v.base + "?before=" + strconv.FormatInt(v.older, 10)) }>Older entries</a>
				</p>
			}
		}
	</section>
}

templ quoteFragment(p priced) {
	if p.err != "" {
		<p class="field-error">{ p.err }</p>
	} else if p.quote.CreditCents > 0 {
		<p class="muted">
			{ FormatEuros(p.quote.CreditCents) } of credit
			if p.quote.FeeCents > 0 {
				+ { FormatEuros(p.quote.FeeCents) } payment fee
			}
			= <strong>{ FormatEuros(p.quote.ChargeCents) }</strong> to pay
		</p>
	}
}

// statusFragment reports a purchase after the buyer returns from the checkout. While
// it is pending, it asks again every two seconds.
templ statusFragment(base, state string) {
	switch state {
		case "paid":
			<p id="purchase-status" class="notice success" role="status">Payment confirmed. Your credit was added.</p>
		case "pending":
			<p id="purchase-status" class="notice" role="status" hx-get={ base + "/status" } hx-trigger="every 2s" hx-swap="outerHTML">
				Thank you. Waiting for the payment to be confirmed…
			</p>
		default:
			<p id="purchase-status" class="notice warning" role="status">The payment is taking longer to confirm. Your credit appears here once it is; you can leave this page.</p>
	}
}

func describe(e Entry) string {
	if e.Description != "" {
		return e.Description
	}
	switch e.Kind {
	case "purchase":
		return "Credit purchase"
	case "debit":
		return "Usage"
	case "expiry":
		return "Credit expired"
	}
	return "Adjustment"
}
