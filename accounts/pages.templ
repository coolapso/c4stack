package accounts

import (
	"github.com/coolapso/c4stack/ui"
	"github.com/gin-gonic/gin"
)

templ settingsPage(v settingsView) {
	<div class="page-header">
		<h1>Account settings</h1>
	</div>
	if v.profile != nil {
		@v.profile
	} else {
		<section class="panel" aria-labelledby="email-title">
			<div class="panel-header">
				<div>
					<h2 id="email-title">Email address</h2>
					<p>The address you sign in with.</p>
				</div>
			</div>
			<p><strong>{ v.account.Email }</strong></p>
		</section>
	}
	<section class="panel danger" aria-labelledby="delete-title">
		<div class="panel-header">
			<div>
				<h2 id="delete-title">Delete account</h2>
				<p>Permanently remove your account and its data. Records the law requires us to keep lose their link to you.</p>
			</div>
			<a class="btn small danger" href={ templ.SafeURL(v.root + deletePath) } data-dialog-open="delete-account-dialog">Delete account</a>
		</div>
	</section>
	<div class="cluster">
		@signOutForm(v, "", "Sign out", "btn ghost small")
	</div>
	@ui.Dialog(ui.DialogProps{ID: "delete-account-dialog", Title: "Delete your account?", Danger: true}) {
		@deleteForm(v)
	}
}

// deletePage confirms the deletion on its own page. The settings page opens the same
// form in a dialog; this page serves direct visits and the server's answers.
templ deletePage(v settingsView) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Delete your account?</h1>
		</div>
		if v.notice != "" {
			<p class="notice warning" role="alert">{ v.notice }</p>
		}
		<section class="panel danger" aria-labelledby="delete-title">
			<h2 id="delete-title">Delete account</h2>
			<p>You are signed in as <strong>{ v.account.Email }</strong>.</p>
			@deleteForm(v)
		</section>
	</div>
}

templ deleteForm(v settingsView) {
	if !v.recent {
		<p>For your security, deleting your account needs a recent sign-in. Sign in again to continue.</p>
		<div class="dialog-actions">
			@signOutForm(v, v.signInAgain, "Sign in again", "btn primary")
		</div>
	} else {
		<p>This permanently removes your account and its data, and any remaining credit is lost. Records the law requires us to keep lose their link to you.</p>
		<form class="stack" method="post" action={ templ.SafeURL(v.root + deletePath) } data-busy-form>
			@ui.CSRFField(v.c)
			<div class="field">
				<label for="delete-confirmation">Type DELETE to confirm</label>
				<input
					id="delete-confirmation"
					name="confirmation"
					type="text"
					autocomplete="off"
					autocapitalize="characters"
					spellcheck="false"
					required
					autofocus
					if v.deleteError != "" {
						aria-invalid="true"
					}
				/>
				if v.deleteError != "" {
					<p class="field-error" role="alert">{ v.deleteError }</p>
				}
			</div>
			<div class="dialog-actions">
				<a class="btn" href={ templ.SafeURL(v.root + settingsPath) } data-dialog-close>Keep my account</a>
				<button type="submit" class="btn danger">
					Delete account
					@ui.Spinner()
				</button>
			</div>
		</form>
	}
}

templ signOutForm(v settingsView, next, label, class string) {
	<form method="post" action={ templ.SafeURL(v.root + logoutPath) } data-busy-form>
		@ui.CSRFField(v.c)
		if next != "" {
			<input type="hidden" name="next" value={ next }/>
		}
		<button type="submit" class={ class }>
			{ label }
			@ui.Spinner()
		</button>
	</form>
}

templ deletedPage(root string, cleanupPending bool) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Your account is deleted</h1>
		</div>
		if cleanupPending {
			<p class="notice warning" role="alert">You can no longer sign in, but removing the rest of your data did not finish. We will complete it; you do not need to do anything.</p>
		} else {
			<p class="lead">Your account and its data are gone.</p>
		}
		<div class="cluster">
			<a class="btn primary" href={ templ.SafeURL(root + "/") }>Back to the home page</a>
		</div>
	</div>
}

templ emailChangedPage(loginPath string) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Email updated</h1>
		</div>
		<p class="lead">Your sign-in email changed and every signed-in device was signed out. Sign in with your new email to continue.</p>
		<div class="cluster">
			<a class="btn primary" href={ templ.SafeURL(loginPath) }>Sign in again</a>
		</div>
	</div>
}

templ unverifiedPage(c *gin.Context, root, loginPath string) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Confirm your email first</h1>
		</div>
		<p class="lead">Your email address is not confirmed yet. Confirm it from the message in your inbox, then sign in again to open your account.</p>
		<div class="cluster">
			<form method="post" action={ templ.SafeURL(root + logoutPath) } data-busy-form>
				@ui.CSRFField(c)
				<input type="hidden" name="next" value={ loginPath }/>
				<button type="submit" class="btn primary">
					Sign in again
					@ui.Spinner()
				</button>
			</form>
			<a class="btn ghost" href={ templ.SafeURL(root + "/") }>Back to the home page</a>
		</div>
	</div>
}
