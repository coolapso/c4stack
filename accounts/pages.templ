package accounts

import (
	"strconv"

	"github.com/coolapso/c4stack/ui"
	"github.com/gin-gonic/gin"
)

templ settingsPage(v settingsView) {
	<div class="page-header">
		<h1>Account settings</h1>
	</div>
	if v.names {
		<section class="panel" aria-labelledby="name-title">
			<div class="panel-header">
				<div>
					<h2 id="name-title">Name</h2>
					<p>What others see you as.</p>
				</div>
			</div>
			<form class="cluster" method="post" action={ templ.SafeURL(v.paths.Name) } data-busy-form>
				@ui.CSRFField(v.c)
				<input type="hidden" name="next" value={ v.paths.Settings }/>
				<label class="sr-only" for="account-name">Name</label>
				<input id="account-name" name="name" value={ v.account.Name } autocomplete="name" maxlength="100" required/>
				<button type="submit" class="btn small">
					Save
					@ui.Spinner()
				</button>
			</form>
		</section>
	}
	if v.profile != nil {
		@v.profile
	} else {
		<section class="panel" aria-labelledby="email-title">
			<div class="panel-header">
				<div>
					<h2 id="email-title">Email address</h2>
					<p>The address you sign in with.</p>
				</div>
			</div>
			<p><strong>{ v.account.Email }</strong></p>
		</section>
	}
	for _, section := range v.sections {
		@section
	}
	<section class="panel danger" aria-labelledby="delete-title">
		<div class="panel-header">
			<div>
				<h2 id="delete-title">Delete account</h2>
				<p>Permanently remove your account and its data. Records the law requires us to keep lose their link to you.</p>
			</div>
			if v.checklist {
				<a class="btn small danger" href={ templ.SafeURL(v.paths.Delete) }>Delete account</a>
			} else {
				<a class="btn small danger" href={ templ.SafeURL(v.paths.Delete) } data-dialog-open="delete-account-dialog">Delete account</a>
			}
		</div>
	</section>
	<div class="cluster">
		@signOutForm(v, "", "Sign out", "btn ghost small")
	</div>
	if !v.checklist {
		@ui.Dialog(ui.DialogProps{ID: "delete-account-dialog", Title: "Delete your account?", Danger: true}) {
			@deleteForm(v, true)
		}
	}
}

// deletePage confirms the deletion on its own page. The settings page opens the same
// form in a dialog; this page serves direct visits and the server's answers.
templ deletePage(v settingsView) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Delete your account?</h1>
		</div>
		if v.notice != "" {
			<p class="notice warning" role="alert">{ v.notice }</p>
		}
		<section class="panel danger" aria-labelledby="delete-title">
			<h2 id="delete-title">Delete account</h2>
			<p>You are signed in as <strong>{ v.account.Email }</strong>.</p>
			if v.checklist {
				@deletionList(v)
			} else {
				@deleteForm(v, false)
			}
		</section>
	</div>
}

// deletionList lists the deletion requirements, a recent sign-in last, and asks to
// confirm once all are met. Until then it asks for itself again every few seconds, for
// up to listFor, and then offers to check again.
templ deletionList(v settingsView) {
	<div
		id="delete-requirements"
		class="stack"
		if v.asking() {
			hx-get={ v.paths.Delete + "?since=" + strconv.FormatInt(v.since, 10) }
			hx-trigger={ "every " + listEvery.String() }
			hx-swap="outerHTML"
		}
	>
		if v.refused != "" {
			<p class="notice warning" role="alert">{ v.refused }</p>
		}
		<p>First, all of these must be done:</p>
		<ul class="item-list" role="list">
			for _, r := range v.requirements {
				<li class={ "item", "requirement", requirementClass(r.Status) }>
					@requirementMark(r.Status)
					<div class="item-main">
						<span>{ r.Name }</span>
						if r.Status != RequirementMet && r.Detail != "" {
							<span class="item-detail">{ r.Detail }</span>
						}
						if r.Status == RequirementUnmet && r.URL != "" {
							<div class="requirement-action">
								<a class="btn small" href={ templ.SafeURL(r.URL) } target="_blank" rel="noopener">
									{ r.Action }
									<span class="sr-only">(opens in a new tab)</span>
								</a>
							</div>
						}
					</div>
				</li>
			}
			<li class={ "item", "requirement", requirementClass(v.recentStatus()) }>
				@requirementMark(v.recentStatus())
				<div class="item-main">
					<span>You signed in recently</span>
					if !v.recent {
						<span class="item-detail">For your security, deleting your account needs a sign-in from the last few minutes.</span>
						<div class="requirement-action">
							if v.confirmURL != "" {
								<a class="btn small" href={ templ.SafeURL(v.confirmURL) }>Confirm it's you</a>
							} else {
								@signOutForm(v, v.signInAgain, "Sign in again", "btn small")
							}
						</div>
					}
				</div>
			</li>
		</ul>
		switch  {
			case v.ready():
				@deleteForm(v, false)
			case v.stopped:
				<p class="item-detail">This page stopped checking by itself.</p>
				<div>
					<a class="btn small" href={ templ.SafeURL(v.paths.Delete) }>Check again</a>
				</div>
			default:
				<p class="item-detail">This list checks again by itself every few seconds.</p>
				<noscript>
					<div>
						<a class="btn small" href={ templ.SafeURL(v.paths.Delete) }>Check again</a>
					</div>
				</noscript>
		}
	</div>
}

templ requirementMark(status RequirementStatus) {
	<span class="requirement-mark" aria-hidden="true">
		switch status {
			case RequirementMet:
				✓
			case RequirementChecking:
				@ui.Spinner()
			default:
				✗
		}
	</span>
	<span class="sr-only">
		switch status {
			case RequirementMet:
				Done:
			case RequirementChecking:
				Checking:
			default:
				Not done yet:
		}
	</span>
}

templ deleteForm(v settingsView, inDialog bool) {
	if v.refused != "" {
		<p class="notice warning" role="alert">{ v.refused }</p>
	} else if !v.recent {
		<p>For your security, deleting your account needs a recent sign-in. Sign in again to continue.</p>
		<div class="dialog-actions">
			if v.confirmURL != "" {
				<a class="btn primary" href={ templ.SafeURL(v.confirmURL) }>Confirm it's you</a>
			} else {
				@signOutForm(v, v.signInAgain, "Sign in again", "btn primary")
			}
		</div>
	} else {
		<p>This permanently removes your account and its data, and any remaining credit is lost. Records the law requires us to keep lose their link to you.</p>
		<form class="stack" method="post" action={ templ.SafeURL(v.paths.Delete) } data-busy-form>
			@ui.CSRFField(v.c)
			<div class="field">
				<label for="delete-confirmation">Type DELETE to confirm</label>
				<input
					id="delete-confirmation"
					name="confirmation"
					type="text"
					autocomplete="off"
					autocapitalize="characters"
					spellcheck="false"
					required
					autofocus
					if v.deleteError != "" {
						aria-invalid="true"
					}
				/>
				if v.deleteError != "" {
					<p class="field-error" role="alert">{ v.deleteError }</p>
				}
			</div>
			<div class="dialog-actions">
				if inDialog {
					<button type="button" class="btn" data-dialog-close>Keep my account</button>
				} else {
					<a class="btn" href={ templ.SafeURL(v.paths.Settings) }>Keep my account</a>
				}
				<button type="submit" class="btn danger">
					Delete account
					@ui.Spinner()
				</button>
			</div>
		</form>
	}
}

templ signOutForm(v settingsView, next, label, class string) {
	<form method="post" action={ templ.SafeURL(v.paths.Logout) } data-busy-form>
		@ui.CSRFField(v.c)
		if next != "" {
			<input type="hidden" name="next" value={ next }/>
		}
		<button type="submit" class={ class }>
			{ label }
			@ui.Spinner()
		</button>
	</form>
}

templ namePage(v nameView) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>What should we call you?</h1>
		</div>
		<p class="lead">This is the name others see. You can change it in your account settings.</p>
		<form class="stack" method="post" action={ templ.SafeURL(v.action) } data-busy-form>
			@ui.CSRFField(v.c)
			<input type="hidden" name="next" value={ v.next }/>
			<div class="field">
				<label for="name">Name</label>
				<input
					id="name"
					name="name"
					value={ v.name }
					autocomplete="name"
					maxlength="100"
					required
					autofocus
					if v.invalid {
						aria-invalid="true"
						aria-describedby="name-error"
					}
				/>
				if v.invalid {
					<p id="name-error" class="field-error">Enter a name of up to 100 characters, without special characters.</p>
				}
			</div>
			<button type="submit" class="btn primary">
				Continue
				@ui.Spinner()
			</button>
		</form>
	</div>
}

templ deletedPage(cleanupPending bool) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Your account is deleted</h1>
		</div>
		if cleanupPending {
			<p class="notice warning" role="alert">Removing your account's data has not finished. We will complete it; you do not need to do anything. You can sign up again once it is done.</p>
		} else {
			<p class="lead">Your account and its data are gone.</p>
		}
		<div class="cluster">
			<a class="btn primary" href="/">Back to the home page</a>
		</div>
	</div>
}

templ emailChangedPage(loginPath string) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Email updated</h1>
		</div>
		<p class="lead">Your sign-in email changed and every signed-in device was signed out. Sign in with your new email to continue.</p>
		<div class="cluster">
			<a class="btn primary" href={ templ.SafeURL(loginPath) }>Sign in again</a>
		</div>
	</div>
}

templ unverifiedPage(c *gin.Context, paths Paths) {
	<div class="narrow stack">
		<div class="page-header">
			<h1>Confirm your email first</h1>
		</div>
		<p class="lead">Your email address is not confirmed yet. Confirm it from the message in your inbox, then sign in again to open your account.</p>
		<div class="cluster">
			<form method="post" action={ templ.SafeURL(paths.Logout) } data-busy-form>
				@ui.CSRFField(c)
				<input type="hidden" name="next" value={ paths.Login }/>
				<button type="submit" class="btn primary">
					Sign in again
					@ui.Spinner()
				</button>
			</form>
			<a class="btn ghost" href="/">Back to the home page</a>
		</div>
	</div>
}
