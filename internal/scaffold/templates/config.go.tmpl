package main

import (
	"errors"
	"log/slog"
	"os"
	"strings"
)

// config holds the settings [[.Title]] reads from [[.EnvPrefix]]_* environment variables.
// [[.EnvPrefix]]_DATABASE_URL is read in main.go, because migrate needs only that.
type config struct {
	PublicURL   string
	Addr        string
	SecretKey   string
	HankoAPIURL string
	LogLevel    slog.Level
	LogFormat   string
}

// env returns the value of [[.EnvPrefix]]_<name>.
func env(name string) string {
	return os.Getenv("[[.EnvPrefix]]_" + name)
}

func loadConfig() (config, error) {
	cfg := config{
		PublicURL:   env("PUBLIC_URL"),
		Addr:        env("ADDR"),
		SecretKey:   env("SECRET_KEY"),
		HankoAPIURL: env("HANKO_API_URL"),
		LogFormat:   env("LOG_FORMAT"),
	}
	if cfg.Addr == "" {
		cfg.Addr = ":8080"
	}
	if level := env("LOG_LEVEL"); level != "" {
		if err := cfg.LogLevel.UnmarshalText([]byte(level)); err != nil {
			return config{}, errors.New("[[.EnvPrefix]]_LOG_LEVEL must be debug, info, warn or error")
		}
	}

	var missing []string
	for _, setting := range []struct{ name, value string }{
		{"PUBLIC_URL", cfg.PublicURL},
		{"SECRET_KEY", cfg.SecretKey},
		{"HANKO_API_URL", cfg.HankoAPIURL},
	} {
		if setting.value == "" {
			missing = append(missing, "[[.EnvPrefix]]_"+setting.name)
		}
	}
	if len(missing) > 0 {
		return config{}, errors.New("set " + strings.Join(missing, ", "))
	}
	return cfg, nil
}

func (c config) logger() *slog.Logger {
	opts := &slog.HandlerOptions{Level: c.LogLevel}
	if c.LogFormat == "text" {
		return slog.New(slog.NewTextHandler(os.Stderr, opts))
	}
	return slog.New(slog.NewJSONHandler(os.Stderr, opts))
}
