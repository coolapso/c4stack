package main

import (
	"embed"
	"io/fs"
	"net/http"

	"github.com/coolapso/c4stack/accounts"
	"github.com/coolapso/c4stack/ui"
	"github.com/coolapso/c4stack/web"
	"github.com/gin-gonic/gin"
)

//go:embed static
var staticFiles embed.FS

// signIn is the identity provider's sign-in pages.
type signIn interface {
	Mount(r gin.IRouter, layout ui.Layout)
}

// routes decides what [[.Title]] serves and where.
func routes(cfg config, idp signIn, accts *accounts.Accounts) (http.Handler, error) {
	gin.SetMode(gin.ReleaseMode)
	r, err := web.New(web.Config{PublicURL: cfg.PublicURL, SecretKey: cfg.SecretKey})
	if err != nil {
		return nil, err
	}

	static, err := fs.Sub(staticFiles, "static")
	if err != nil {
		return nil, err
	}
	assets := ui.NewAssets("/assets")
	if err := assets.Add("app", static); err != nil {
		return nil, err
	}
	layout := newLayout(assets)

	r.GET("/assets/*path", assets.Serve)
	r.NoRoute(layout.NotFound)
	r.GET("/", func(c *gin.Context) {
		layout.Render(c, http.StatusOK, "", homePage())
	})

	// Sign-in, the account pages, and the app's own signed-in pages.
	idp.Mount(r, layout)
	accts.Mount(r, layout)
	account := r.Group("/account", accts.RequireSignIn)
	account.GET("", func(c *gin.Context) {
		layout.Render(c, http.StatusOK, "Your account", accountPage(accounts.Current(c)))
	})

	return r, nil
}
