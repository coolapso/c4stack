# [[.Title]]'s tasks. The shared tasks (dev, test, check, build, db:migrate and more)
# come from the C4Stack release in go.mod; run `task --list` to see them all.
#
# To change a shared task, add its name to `excludes` below and define your own task
# with the same name under `tasks`.
version: '3'

vars:
  APP: [[.Name]]
  ENV_PREFIX: [[.EnvPrefix]]
  IMAGE: [[.Name]]
  # REGISTRY: ghcr.io/you
  # Run dev, run and db:migrate under `infisical run`:
  # INFISICAL_PROJECT: <project-id>
  # INFISICAL_ENV: dev
  # The C4Stack release in go.mod. task framework:update changes both, and task check
  # fails when they differ.
  FRAMEWORK_VERSION: [[.Version]]

dotenv: ['.env']

includes:
  shared:
    taskfile: [[.Taskfile]]
    flatten: true
    excludes: []

tasks: {}
