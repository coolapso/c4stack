# [[.Title]]'s tasks. The shared tasks (dev, test, check, build, db:migrate and more)
# come from the C4Stack release in go.mod; run `task --list` to see them all.
#
# To change a shared task, add its name to `excludes` below and define your own task
# with the same name under `tasks`.
version: '3'

vars:
  APP: [[.Name]]
  ENV_PREFIX: [[.EnvPrefix]]
  IMAGE: [[.Name]]
  # REGISTRY: ghcr.io/you
  # Give dev, run and db:migrate an Infisical environment's secrets: its root folder's,
  # with `infisical run`, or the ones INFISICAL_SECRETS names, by their path:
  # INFISICAL_PROJECT: <project-id>
  # INFISICAL_ENV: dev
  # INFISICAL_SECRETS:
  #   map:
  #     [[.EnvPrefix]]_CREEM_API_KEY: /creem/API_KEY
  # The C4Stack release in go.mod. task framework:update changes both, and task check
  # fails when they differ.
  FRAMEWORK_VERSION: [[.Version]]

# The settings task dev, task run and task db:migrate give the app. None is a secret: the
# secret key is a new one each time a task starts, which development doesn't mind,
# since sessions live in the database. Variables already set in your shell win, and
# with INFISICAL_PROJECT set, Infisical adds that environment's secrets. Never
# keep settings in a .env file.
env:
  [[.EnvPrefix]]_PUBLIC_URL: http://localhost:8080
  [[.EnvPrefix]]_DATABASE_URL: postgres://[[.Name]]:[[.Name]]@localhost:5432/[[.Name]]?sslmode=disable
  [[- if .Hanko]]
  # Your Hanko Cloud tenant's API URL, with http://localhost:8080 as its app URL.
  [[.EnvPrefix]]_HANKO_API_URL: https://your-tenant.hanko.io
  [[- else]]
  # Mailpit, from docker-compose.yml (task mail:up), catches the emails: sign-in codes
  # and notices show up at http://localhost:8025.
  [[.EnvPrefix]]_SMTP_URL: smtp://localhost:1025
  [[.EnvPrefix]]_EMAIL_FROM: noreply@localhost
  [[- end]]
  [[.EnvPrefix]]_LOG_FORMAT: text
  [[.EnvPrefix]]_LOG_LEVEL: debug
  [[.EnvPrefix]]_SECRET_KEY:
    sh: openssl rand -hex 32

includes:
  shared:
    taskfile: [[.Taskfile]]
    flatten: true
    excludes: []

tasks: {}
