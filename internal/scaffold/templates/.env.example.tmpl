# Settings for local development. task dev and task db:migrate read .env, which the
# generator created with a fresh secret key. Never commit .env.

# Where the app is reached. task dev serves on port 8080.
[[.EnvPrefix]]_PUBLIC_URL=http://localhost:8080
# The local database from docker-compose.yml (task db:up).
[[.EnvPrefix]]_DATABASE_URL=postgres://[[.Name]]:[[.Name]]@localhost:5432/[[.Name]]?sslmode=disable
# At least 32 bytes, the same on every replica: openssl rand -hex 32
[[.EnvPrefix]]_SECRET_KEY=
# Your Hanko Cloud tenant's API URL, with http://localhost:8080 as its app URL.
[[.EnvPrefix]]_HANKO_API_URL=https://your-tenant.hanko.io
[[.EnvPrefix]]_LOG_FORMAT=text
[[.EnvPrefix]]_LOG_LEVEL=debug
