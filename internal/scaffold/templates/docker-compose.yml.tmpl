# The local development services. task db:up starts the database, task db:wipe deletes
# its data.[[if not .Hanko]] task mail:up starts Mailpit, which catches the app's emails.[[end]]
name: [[.Name]]

services:
  postgres:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: [[.Name]]
      POSTGRES_PASSWORD: [[.Name]]
      POSTGRES_DB: [[.Name]]
    ports:
      - 127.0.0.1:${DB_PORT:-5432}:5432
    volumes:
      - postgres:/var/lib/postgresql
    healthcheck:
      test: [CMD, pg_isready, -U, [[.Name]], -d, [[.Name]]]
      interval: 2s
      timeout: 3s
      retries: 30
  [[- if not .Hanko]]

  # Catches every email the app sends, such as sign-in codes. Its inbox is
  # http://localhost:8025.
  mailpit:
    image: axllent/mailpit:v1.34
    ports:
      - 127.0.0.1:1025:1025
      - 127.0.0.1:8025:8025
  [[- end]]

volumes:
  postgres:
